{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "types": ["vite/client"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    // tsc runs as a type check only; vite build owns `dist`.
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsconfig.app"
  },
  // `src/assets/*.json` is imported by the overlay, so the JSON has to be in
  // the project, not just the .ts alongside it.
  "include": ["src", "src/**/*.json"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
